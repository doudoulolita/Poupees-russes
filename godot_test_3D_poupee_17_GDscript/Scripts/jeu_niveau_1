extends Node3D

@export var attak_scene: PackedScene

func _on_attak_timer_timeout() -> void:
	# Crée une nouvelle instance de fleur attack dans la scène attak
	var attak_instance = attak_scene.instantiate()
	
	var attak_spawn_location = $SpawnPath/SpawnLocation
	# Donne un offset aléatoire
	attak_spawn_location.progress_ratio = randf()
	
	var player_position = $poupee_01.global_position
	attak_instance.initialize(attak_spawn_location.global_position, player_position)
	
	# var cible_plateforme = Vector3.ZERO
	# attak_instance.initialize(attak_spawn_location.global_position, cible_plateforme)
	
	# Instancie la fleur Attak dans la scène principale
	add_child(attak_instance)
